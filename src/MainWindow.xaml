<Window x:Class="HelperAsta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helper Asta"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CARICAMENTO FILE -->
        <Border Grid.Row="0"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCaricaCsv"
                        Grid.Column="0"
                        Content="Carica CSV"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BtnCaricaCsv_Click"/>

                <TextBlock x:Name="TxtFileCaricato"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Nessun file caricato"
                           Foreground="Gray"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- FILTRI -->
        <Border Grid.Row="1"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ETICHETTE -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Nome"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="Ruolo"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Squadra"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="Titolarità"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="4"
                           Text="Obiettivo"
                           FontWeight="SemiBold"
                           Margin="0,0,10,5"/>

                <!-- INPUT -->

                <TextBox x:Name="TxtNome"
                         Grid.Row="1"
                         Grid.Column="0"
                         Height="32"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtNome_KeyDown"/>

                <ComboBox x:Name="CmbRuolo"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,0,10,0"/>

                <ComboBox x:Name="CmbSquadra"
                          Grid.Row="1"
                          Grid.Column="2"
                          Height="32"
                          Margin="0,0,10,0"/>

                <ComboBox x:Name="CmbTitolarita"
                          Grid.Row="1"
                          Grid.Column="3"
                          Height="32"
                          Margin="0,0,10,0"/>

                <ComboBox x:Name="CmbObiettivo"
                          Grid.Row="1"
                          Grid.Column="4"
                          Height="32"
                          Margin="0,0,10,0"/>

                <Button x:Name="BtnCerca"
                        Grid.Row="1"
                        Grid.Column="5"
                        Content="Cerca"
                        Width="90"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="BtnCerca_Click"/>

                <Button x:Name="BtnReset"
                        Grid.Row="1"
                        Grid.Column="6"
                        Content="Reset filtri"
                        Width="100"
                        Height="32"
                        Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- RISULTATI -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="0,0,0,8">

                <TextBlock Text="Risultati"
                           FontSize="18"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>

                <TextBlock x:Name="TxtContatore"
                           Text="Giocatori disponibili: 0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- TABELLA -->
            <DataGrid x:Name="DgGiocatori"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      FrozenColumnCount="1"
                      MouseDoubleClick="DgGiocatori_MouseDoubleClick">

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nome"
                        Binding="{Binding Nome}"
                        Width="100"/>

                    <DataGridTextColumn Header="Squadra"
                        Binding="{Binding Squadra}"
                        Width="80"/>

                    <DataGridTextColumn Header="Ruolo"
                        Binding="{Binding Ruolo}"
                        Width="60"/>

                    <DataGridTextColumn Header="Tit"
                        Binding="{Binding Titolarita}"
                        Width="80"/>

                    <DataGridTextColumn Header="Par"
                        Binding="{Binding Partite}"
                        Width="70"/>

                    <DataGridTextColumn Header="MV"
                        Binding="{Binding Media, StringFormat={}{0:0.00}}"
                        Width="70"/>

                    <DataGridTextColumn Header="FM"
                        Binding="{Binding Fantamedia, StringFormat={}{0:0.00}}"
                        Width="90"/>

                    <DataGridTextColumn Header="Obiettivo"
                        Binding="{Binding Obiettivo}"
                        Width="110"/>

                    <DataGridTextColumn Header="Gol"
                        Binding="{Binding Gol}"
                        Width="60"/>

                    <DataGridTextColumn Header="Ass"
                        Binding="{Binding Assist}"
                        Width="60"/>

                    <DataGridTextColumn Header="Rig"
                        Binding="{Binding Rigori}"
                        Width="60"/>

                    <DataGridTextColumn Header="Pun"
                        Binding="{Binding Punizioni}"
                        Width="60"/>

                    <DataGridTextColumn Header="Gia"
                        Binding="{Binding Gialli}"
                        Width="60"/>

                    <DataGridTextColumn Header="Ros"
                        Binding="{Binding Rossi}"
                        Width="60"/>

                    <DataGridTextColumn Header="Inf"
                        Binding="{Binding Infortunio}"
                        Width="100"/>

                    <DataGridTextColumn Header="Est"
                        Binding="{Binding Estero}"
                        Width="80"/>

                    <DataGridTextColumn Header="All"
                        Binding="{Binding Allenatore}"
                        Width="80"/>

                    <DataGridTextColumn Header="Situa"
                        Binding="{Binding SituazioneAllenatore}"
                        Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>